# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 호스트에 이미 MySQL이 떠있는 경우를 대비해 호스트 노출 포트는 별도로 둔다 (컨테이너 내부는 항상 3306)
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=stackus
MYSQL_USERNAME=stackus
MYSQL_PASSWORD=stackus_password
MYSQL_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend (Vite는 VITE_ 접두사가 있는 변수만 클라이언트에 노출)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
